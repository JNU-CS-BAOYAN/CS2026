---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import ExperienceCard from '../components/ExperienceCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { groupByYear, sortByPublishedAt } from '../lib/experiences';
import forewordArt from '../assets/foreword.svg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const experiences = await getCollection('experiences', ({ data }) => !data.draft);
const sorted = sortByPublishedAt(experiences);
const pageSize = 6;
const pageCount = Math.max(1, Math.ceil(sorted.length / pageSize));
const years = [...groupByYear(experiences).keys()];
const foreword = await getEntry('pages', 'foreword');
const forewordSummary = foreword?.data.description ?? '项目说明、经验来源与投稿方式。';
const forewordCover = foreword?.data.image ?? forewordArt;
---
<SiteLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">JNU · CS · BAOYAN</p>
      <h1 class="hero-title">愿你的准备，都有回响</h1>
      <p class="hero-lead">
        JNU CS BAOYAN 收集江南大学计算机相关专业的保研经验、准备资料和流程记录，
        按申请年份整理，方便后来者从真实经历中找到自己的参考。
      </p>
      <div class="hero-actions">
        <a class="button" href={`${base}/experiences/`}>浏览经验贴</a>
        <a class="button-secondary" href={`${base}/submit/`}>分享一篇经验</a>
      </div>
    </div>
    <div class="hero-art">
      <Image src={forewordCover} alt="JNU CS BAOYAN 项目介绍封面" width={1200} height={650} />
    </div>
  </section>

  {foreword && (
    <section class="foreword" aria-labelledby="foreword-title">
      <div class="section-heading">
        <h2 id="foreword-title"><span class="heading-icon" aria-hidden="true">✦</span> 启航絮语</h2>
        <a href={`${base}/foreword/`}>阅读全文 →</a>
      </div>
      <a class="foreword-card" href={`${base}/foreword/`}>
        <span class="foreword-summary">
          <span class="foreword-card-art" aria-hidden="true">
          <Image src={forewordCover} alt="项目介绍配图" width={1200} height={650} />
          </span>
          <span class="foreword-card-body">
            <span class="eyebrow">PROJECT NOTE</span>
            <span class="foreword-card-title">愿你的准备，都有回响</span>
            <span class="foreword-card-description">{forewordSummary}</span>
            <span class="read-link">进入文章 <span aria-hidden="true">→</span></span>
          </span>
        </span>
      </a>
    </section>
  )}

  <section class="section-block" aria-labelledby="latest-title">
    <div class="section-heading">
      <h2 id="latest-title"><span class="heading-icon" aria-hidden="true">⌁</span> 最新收录</h2>
      <a href={`${base}/experiences/`}>全部文章 →</a>
    </div>
    {sorted.length ? (
      <>
        <div class="experience-grid home-experience-grid" data-home-grid>
          {sorted.map((entry, index) => (
            <div class="pagination-item" data-home-item hidden={index >= pageSize}>
              <ExperienceCard entry={entry} />
            </div>
          ))}
        </div>
        {pageCount > 1 && (
          <nav class="pagination home-pagination" data-home-pagination aria-label="最新收录分页">
            <span class="pagination-label">共 {sorted.length} 篇</span>
            <div class="pagination-links">
              {Array.from({ length: pageCount }, (_, index) => index + 1).map((page) => (
                <button type="button" class:list={{ active: page === 1 }} data-home-page={page} aria-current={page === 1 ? 'page' : undefined}>{page}</button>
              ))}
            </div>
          </nav>
        )}
      </>
    ) : (
      <p class="empty-state">经验贴正在整理中，欢迎提交第一篇分享。</p>
    )}
  </section>

  <script>
    const pagination = document.querySelector<HTMLElement>('[data-home-pagination]');
    const grid = document.querySelector<HTMLElement>('[data-home-grid]');
    if (pagination && grid) {
      const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-home-item]'));
      const buttons = Array.from(pagination.querySelectorAll<HTMLButtonElement>('[data-home-page]'));
      const pageSize = 6;
      const queryPage = Number(new URLSearchParams(window.location.search).get('page'));
      const initialPage = Number.isFinite(queryPage) && queryPage > 0 ? queryPage : 1;
      const setPage = (page: number, updateUrl = true) => {
        const safePage = Math.min(Math.max(1, page), buttons.length);
        items.forEach((item, index) => {
          item.hidden = Math.floor(index / pageSize) + 1 !== safePage;
        });
        buttons.forEach((button) => {
          const active = Number(button.dataset.homePage) === safePage;
          button.classList.toggle('active', active);
          if (active) button.setAttribute('aria-current', 'page');
          else button.removeAttribute('aria-current');
        });
        if (updateUrl) {
          const url = new URL(window.location.href);
          if (safePage === 1) url.searchParams.delete('page');
          else url.searchParams.set('page', String(safePage));
          window.history.replaceState({}, '', url);
        }
      };
      buttons.forEach((button) => button.addEventListener('click', () => setPage(Number(button.dataset.homePage))));
      setPage(initialPage, false);
    }
  </script>

  <section class="section-block" aria-labelledby="years-title">
    <div class="section-heading">
      <h2 id="years-title">按申请年份浏览</h2>
      <a href={`${base}/experiences/`}>查看全部 →</a>
    </div>
    <div class="year-list">
      {years.map((year) => (
        <a class="year-link" href={`${base}/experiences/${year}/`}>
          <strong>{year}</strong>
          <span>{groupByYear(experiences).get(year)?.length ?? 0} 篇经验贴</span>
        </a>
      ))}
    </div>
  </section>

</SiteLayout>


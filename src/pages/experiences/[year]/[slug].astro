---
import { render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getExperiences, experienceSlug, sortExperiences, type ExperienceEntry } from '../../../lib/experiences';

export async function getStaticPaths() {
  const experiences = await getExperiences();
  return sortExperiences(experiences).map((entry) => ({
    params: { year: String(entry.data.applicationYear), slug: experienceSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: ExperienceEntry };
const { Content, headings } = await render(entry);
---
<ArticleLayout entry={entry} headings={headings}><Content /></ArticleLayout>


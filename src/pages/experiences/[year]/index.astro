---
import ExperienceCard from '../../../components/ExperienceCard.astro';
import Pagination from '../../../components/Pagination.astro';
import YearNav from '../../../components/YearNav.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getExperiences, groupByYear, type ExperienceEntry } from '../../../lib/experiences';
import { EXPERIENCE_PAGE_SIZE, pageSlice, totalPages } from '../../../lib/pagination';

export async function getStaticPaths() {
  const experiences = await getExperiences();
  const groups = groupByYear(experiences);
  const years = [...groups.keys()];
  return years.map((year) => ({
    params: { year: String(year) },
    props: { entries: pageSlice(groups.get(year) ?? [], 1, EXPERIENCE_PAGE_SIZE), pageCount: totalPages(groups.get(year)?.length ?? 0), years },
  }));
}

const { entries, pageCount, years: allYears } = Astro.props as { entries: ExperienceEntry[]; pageCount: number; years: number[] };
const year = Number(Astro.params.year);
---
<SiteLayout title={`${year} 年经验贴`}>
  <header class="page-title">
    <p class="eyebrow">APPLICATION YEAR</p>
    <h1>{year} 年经验贴</h1>
    <p>这一年申请季留下的经验分享。</p>
  </header>
  <YearNav years={allYears} currentYear={year} />
  {entries.length ? (
    <div class="experience-grid">
      {entries.map((entry) => <ExperienceCard entry={entry} />)}
    </div>
  ) : (
    <p class="empty-state">这一年暂时没有公开经验贴。</p>
  )}
  <Pagination currentPage={1} totalPages={pageCount} pathPrefix={`/experiences/${year}/`} />
</SiteLayout>


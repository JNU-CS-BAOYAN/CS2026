---
import { getCollection } from 'astro:content';
import ExperienceCard from '../../components/ExperienceCard.astro';
import Pagination from '../../components/Pagination.astro';
import YearNav from '../../components/YearNav.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { groupByYear, sortExperiences } from '../../lib/experiences';
import { EXPERIENCE_PAGE_SIZE, pageSlice, totalPages } from '../../lib/pagination';

const experiences = await getCollection('experiences', ({ data }) => !data.draft);
const sorted = sortExperiences(experiences);
const groups = groupByYear(experiences);
const years = [...groups.keys()];
const pageCount = totalPages(sorted.length);
---
<SiteLayout title="经验贴">
  <header class="page-title">
    <p class="eyebrow">EXPERIENCES</p>
    <h1>经验贴</h1>
    <p>按申请年份浏览真实经历，也可以点击卡片中的本科专业或院校进行搜索。具体申请过程与阶段保留在作者的叙述中。</p>
  </header>
  <YearNav years={years} />
  {sorted.length ? (
    <div class="experience-grid">
      {pageSlice(sorted, 1, EXPERIENCE_PAGE_SIZE).map((entry) => <ExperienceCard entry={entry} />)}
    </div>
  ) : (
    <p class="empty-state">经验贴正在整理中。</p>
  )}
  <Pagination currentPage={1} totalPages={pageCount} pathPrefix="/experiences/" />
</SiteLayout>


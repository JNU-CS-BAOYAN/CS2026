---
import ExperienceCard from '../../../components/ExperienceCard.astro';
import Pagination from '../../../components/Pagination.astro';
import YearNav from '../../../components/YearNav.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getExperiences, groupByYear, sortExperiences, type ExperienceEntry } from '../../../lib/experiences';
import { EXPERIENCE_PAGE_SIZE, pageSlice, totalPages } from '../../../lib/pagination';

export async function getStaticPaths() {
  const experiences = await getExperiences();
  const sorted = sortExperiences(experiences);
  const pageCount = totalPages(sorted.length);
  const years = [...groupByYear(experiences).keys()];
  return Array.from({ length: pageCount - 1 }, (_, index) => index + 2).map((page) => ({
    params: { page: String(page) },
    props: { entries: pageSlice(sorted, page, EXPERIENCE_PAGE_SIZE), page, pageCount, years },
  }));
}

const { entries, page, pageCount, years } = Astro.props as {
  entries: ExperienceEntry[];
  page: number;
  pageCount: number;
  years: number[];
};
---
<SiteLayout title={`经验贴 · 第 ${page} 页`}>
  <header class="page-title">
    <p class="eyebrow">EXPERIENCES</p>
    <h1>经验贴</h1>
    <p>按申请年份浏览真实经历。文章中的院校和阶段信息保持在作者自己的叙述里。</p>
  </header>
  <YearNav years={years} />
  <div class="experience-grid">
    {entries.map((entry) => <ExperienceCard entry={entry} />)}
  </div>
  <Pagination currentPage={page} totalPages={pageCount} pathPrefix="/experiences/" />
</SiteLayout>

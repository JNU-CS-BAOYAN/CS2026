---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  fontPreloadText?: string;
}
const { title = SITE_TITLE, description = SITE_DESCRIPTION, wide = false, fontPreloadText } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} fontPreloadText={fontPreloadText} />
  </head>
  <body>
    <Header />
    <main class:list={{ 'page-shell': true, 'page-shell-wide': wide }}><slot /></main>
    <Footer />
  </body>
</html>


---
import { Image } from 'astro:assets';
import type { ExperienceEntry } from '../lib/experiences';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { pooledCover } from '../lib/cover-pool';
import TableOfContents from '../components/TableOfContents.astro';
import ExperienceMetadata from '../components/ExperienceMetadata.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: ExperienceEntry;
  headings?: Heading[];
}
const { entry } = Astro.props;
const { headings = [] } = Astro.props;
const data = entry.data;
const cover = data.cover ?? pooledCover(entry.id);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={data.title} description={`${data.applicationYear} 年保研经验 · ${data.author} · ${data.title}`} />
  </head>
  <body>
    <Header />
    <main class="article-shell">
      <a class="back-link" href={`${base}/experiences/`}>← 返回经验贴</a>
      <div class="article-layout-grid">
        <TableOfContents headings={headings} />
        <article class="article">
          <Image class="article-cover" src={cover} alt={`${data.title}封面`} width={1200} height={675} />
          <header class="article-header">
            <p class="eyebrow">{data.applicationYear} · {data.author}</p>
            <h1>{data.title}</h1>
            <div class="article-meta">
              {data.publishedAt && <span>发布于 <FormattedDate date={data.publishedAt} /></span>}
              {data.finalDestination && <span>最终去向：{data.finalDestination}</span>}
            </div>
            <ExperienceMetadata undergraduateMajor={data.undergraduateMajor} institutions={data.institutions} />
          </header>
          <div class="prose"><slot /></div>
        </article>
      </div>
      <nav class="article-end-nav" aria-label="文章导航">
        <a href={`${base}/experiences/${data.applicationYear}/`}>浏览 {data.applicationYear} 年经验贴</a>
        <a href={`${base}/experiences/`}>查看全部经验贴</a>
      </nav>
    </main>
    <Footer />
  </body>
</html>


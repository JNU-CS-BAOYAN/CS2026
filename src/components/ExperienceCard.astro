---
import { Image } from 'astro:assets';
import type { ExperienceEntry } from '../lib/experiences';
import { experiencePath } from '../lib/experiences';
import { pooledCover } from '../lib/cover-pool';
import ExperienceMetadata from './ExperienceMetadata.astro';

interface Props {
  entry: ExperienceEntry;
}
const { entry } = Astro.props;
const cover = entry.data.cover ?? pooledCover(entry.id);
---
<article class="experience-card">
  <a class="card-cover" href={experiencePath(entry)}>
    <Image src={cover} alt={`${entry.data.title}封面`} width={720} height={405} />
  </a>
  <div class="card-body">
    <p class="eyebrow">{entry.data.applicationYear} · {entry.data.author}</p>
    <h3><a href={experiencePath(entry)} title={entry.data.title}>{entry.data.title}</a></h3>
    <ExperienceMetadata undergraduateMajor={entry.data.undergraduateMajor} institutions={entry.data.institutions} compact />
    <a class="read-link" href={experiencePath(entry)}>阅读全文 <span aria-hidden="true">→</span></a>
  </div>
</article>


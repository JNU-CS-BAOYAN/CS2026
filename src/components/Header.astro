---
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  ['经验贴', '/experiences/'],
  ['保研流程', '/guide/'],
  ['资料与工具', '/resources/'],
  ['投稿', '/submit/'],
  ['关于', '/about/'],
] as const;
const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
const hrefFor = (path: string) => `${base}${path}`;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={hrefFor('/')}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" focusable="false">
          <path d="M7 8.5c4.1-.9 7.2-.3 9 1.6v14.2c-1.8-1.9-4.9-2.5-9-1.6V8.5Z" />
          <path d="M25 8.5c-4.1-.9-7.2-.3-9 1.6v14.2c1.8-1.9 4.9-2.5 9-1.6V8.5Z" />
          <path class="brand-sprout" d="M21.8 6.2c-1.8.1-3.2.8-4.2 2.2 1.9.2 3.4-.5 4.2-2.2Z" />
        </svg>
      </span>
      <span>{SITE_TITLE}</span>
    </a>
    <nav aria-label="主导航">
      <form class="header-search" action={hrefFor('/search/')} method="get" role="search">
        <label class="sr-only" for="header-search-input">全站搜索</label>
        <input id="header-search-input" type="search" name="q" placeholder="搜索" aria-label="全站搜索" />
        <button type="submit" aria-label="提交搜索">⌕</button>
      </form>
      <a class:list={{ active: currentPath === '/' }} href={hrefFor('/')}>首页</a>
      {links.map(([label, path]) => (
        <a class:list={{ active: currentPath.startsWith(path) }} href={hrefFor(path)}>{label}</a>
      ))}
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换日夜主题" title="切换日夜主题"><span aria-hidden="true">☾</span></button>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  try {
    const storedTheme = localStorage.getItem('jnu-cs-baoyan-theme');
    if (storedTheme === 'dark' || storedTheme === 'light') root.dataset.theme = storedTheme;
  } catch {}
  const updateThemeButton = () => {
    const dark = root.dataset.theme === 'dark';
    if (toggle) {
      toggle.querySelector('span')!.textContent = dark ? '☀' : '☾';
      toggle.setAttribute('aria-label', dark ? '切换日间主题' : '切换夜间主题');
    }
  };
  updateThemeButton();
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('jnu-cs-baoyan-theme', next); } catch {}
    updateThemeButton();
  });
</script>


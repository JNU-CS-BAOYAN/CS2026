---
import type { ExperienceEntry } from '../lib/experiences';
import { experiencePath } from '../lib/experiences';
import { institutionDisplayName, institutionSearchText } from '../lib/institutions';

interface Props {
  entries: ExperienceEntry[];
}

const { entries } = Astro.props;
const records = entries.map((entry) => ({
  title: entry.data.title,
  author: entry.data.author,
  year: entry.data.applicationYear,
  undergraduateMajor: entry.data.undergraduateMajor ?? '',
  institutions: entry.data.institutions.map(institutionDisplayName),
  institutionKeywords: institutionSearchText(entry.data.institutions),
  text: (entry.body ?? '').replace(/<!--[\s\S]*?-->/g, ''),
  path: experiencePath(entry),
}));
const serialized = JSON.stringify(records).replace(/</g, '\\u003c');
---

<section class="search-panel" data-search-panel>
  <form class="search-form" data-search-form role="search">
    <label class="sr-only" for="experience-search">搜索经验贴</label>
    <input id="experience-search" type="search" name="q" placeholder="搜索标题、作者、专业、院校或正文" autocomplete="off" data-search-input />
    <button class="button" type="submit">搜索</button>
  </form>
  <p class="search-hint" data-search-hint>支持搜索标题、作者、申请年份、本科专业、涉及院校和正文；多个关键词用空格分隔。</p>
  <div class="search-results" data-search-results aria-live="polite"></div>
</section>

<script type="application/json" data-search-index set:html={serialized}></script>
<script>
  interface SearchRecord {
    title: string;
    author: string;
    year: number;
    undergraduateMajor: string;
    institutions: string[];
    institutionKeywords: string;
    text: string;
    path: string;
  }

  const panel = document.querySelector<HTMLElement>('[data-search-panel]');
  const form = panel?.querySelector<HTMLFormElement>('[data-search-form]');
  const input = panel?.querySelector<HTMLInputElement>('[data-search-input]');
  const results = panel?.querySelector<HTMLElement>('[data-search-results]');
  const hint = panel?.querySelector<HTMLElement>('[data-search-hint]');
  const data = JSON.parse(document.querySelector<HTMLScriptElement>('[data-search-index]')?.textContent ?? '[]') as SearchRecord[];

  const normalize = (value: string) => value.toLocaleLowerCase().replace(/[\s\p{P}\p{S}]+/gu, ' ').trim();
  const render = (query: string) => {
    if (!results || !hint) return;
    const normalizedQuery = normalize(query);
    if (!normalizedQuery) {
      results.replaceChildren();
      hint.textContent = '支持搜索标题、作者、申请年份、本科专业、涉及院校和正文；多个关键词用空格分隔。';
      return;
    }
    const terms = normalizedQuery.split(' ');
    const matches = data.filter((item) => {
      const searchable = normalize(`${item.title} ${item.author} ${item.year} ${item.undergraduateMajor} ${item.institutionKeywords} ${item.text}`);
      return terms.every((term) => searchable.includes(term));
    });
    results.replaceChildren();
    hint.textContent = `找到 ${matches.length} 篇相关经验贴`;
    for (const item of matches) {
      const card = document.createElement('article');
      card.className = 'search-result';
      const link = document.createElement('a');
      link.href = item.path;
      link.className = 'search-result-title';
      link.textContent = item.title;
      const meta = document.createElement('p');
      meta.className = 'search-result-meta';
      const metadata = [`${item.year}`, item.author];
      if (item.undergraduateMajor) metadata.push(item.undergraduateMajor);
      if (item.institutions.length) metadata.push(`涉及院校：${item.institutions.slice(0, 3).join('、')}${item.institutions.length > 3 ? ` 等 ${item.institutions.length} 所` : ''}`);
      meta.textContent = metadata.join(' · ');
      const source = item.text.replace(/[#*_`>\[\]()]/g, ' ').replace(/\s+/g, ' ').trim();
      const position = normalize(source).indexOf(normalizedQuery);
      const start = Math.max(0, position - 55);
      const snippet = document.createElement('p');
      snippet.className = 'search-result-snippet';
      snippet.textContent = `${start > 0 ? '…' : ''}${source.slice(start, start + 180)}${start + 180 < source.length ? '…' : ''}`;
      card.append(link, meta, snippet);
      results.append(card);
    }
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = input?.value ?? '';
    const url = new URL(window.location.href);
    query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
    window.history.replaceState({}, '', url);
    render(query);
  });
  input?.addEventListener('input', () => render(input.value));
  if (input) {
    const query = new URLSearchParams(window.location.search).get('q') ?? '';
    input.value = query;
    render(query);
  }
</script>

---
import { sitePath } from '../lib/experiences';
import type { SearchRecord } from '../lib/search';

interface Props {
  records: SearchRecord[];
}

const { records } = Astro.props;
const serialized = JSON.stringify(records).replace(/</g, '\\u003c');
---

<section class="search-panel" data-search-panel>
  <form class="search-form" data-search-form role="search">
    <label class="sr-only" for="site-search">全站搜索</label>
    <input id="site-search" type="search" name="q" placeholder="搜索经验、资料、流程或投稿说明" autocomplete="off" data-search-input />
    <button class="button" type="submit">搜索</button>
  </form>
  <p class="search-hint" data-search-hint>搜索全站标题和正文，也支持经验贴的作者、年份、专业及院校；多个关键词用空格分隔。</p>
  <div class="search-results" data-search-results aria-live="polite"></div>
  <noscript>
    <style is:inline>.search-panel .search-form { display: none; }</style>
    <p class="search-hint">搜索需要启用 JavaScript。你也可以<a href={sitePath('/experiences/')}>按年份和页码浏览经验贴</a>，或打开<a href={sitePath('/resources/')}>资料与工具</a>、<a href={sitePath('/guide/')}>保研流程</a>和<a href={sitePath('/submit/')}>投稿说明</a>。</p>
  </noscript>
</section>

<script type="application/json" data-search-index set:html={serialized}></script>
<script>
  import { searchRecords, searchSnippet, normalizeSearch, type SearchRecord } from '../lib/search';

  const panel = document.querySelector<HTMLElement>('[data-search-panel]');
  const form = panel?.querySelector<HTMLFormElement>('[data-search-form]');
  const input = panel?.querySelector<HTMLInputElement>('[data-search-input]');
  const results = panel?.querySelector<HTMLElement>('[data-search-results]');
  const hint = panel?.querySelector<HTMLElement>('[data-search-hint]');
  const data = JSON.parse(document.querySelector<HTMLScriptElement>('[data-search-index]')?.textContent ?? '[]') as SearchRecord[];

  const render = (query: string) => {
    if (!results || !hint) return;
    const normalizedQuery = normalizeSearch(query);
    if (!normalizedQuery) {
      results.replaceChildren();
      hint.textContent = '搜索全站标题和正文，也支持经验贴的作者、年份、专业及院校；多个关键词用空格分隔。';
      return;
    }
    const matches = searchRecords(data, query);
    results.replaceChildren();
    hint.textContent = `找到 ${matches.length} 条相关内容`;
    for (const item of matches) {
      const card = document.createElement('article');
      card.className = 'search-result';
      const link = document.createElement('a');
      link.href = item.path;
      link.className = 'search-result-title';
      link.textContent = item.title;
      const meta = document.createElement('p');
      meta.className = 'search-result-meta';
      const metadata = item.kind === 'experience' ? ['经验贴', `${item.year}`, item.author] : ['站点说明', item.section];
      if (item.undergraduateMajor) metadata.push(item.undergraduateMajor);
      if (item.institutions.length) metadata.push(`涉及院校：${item.institutions.slice(0, 3).join('、')}${item.institutions.length > 3 ? ` 等 ${item.institutions.length} 所` : ''}`);
      meta.textContent = metadata.join(' · ');
      const snippet = document.createElement('p');
      snippet.className = 'search-result-snippet';
      snippet.textContent = searchSnippet(item.text, query);
      card.append(link, meta, snippet);
      results.append(card);
    }
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = input?.value ?? '';
    const url = new URL(window.location.href);
    query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
    window.history.replaceState({}, '', url);
    render(query);
  });
  input?.addEventListener('input', () => render(input.value));
  if (input) {
    const query = new URLSearchParams(window.location.search).get('q') ?? '';
    input.value = query;
    render(query);
  }
</script>

---
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
// Astro emits the error page as 404.html, rather than a /404/ directory.
const canonicalPath = Astro.url.pathname.replace(/\/404\/?$/, '/404.html');
const canonicalURL = new URL(canonicalPath, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  try {
    const theme = localStorage.getItem('jnu-cs-baoyan-theme');
    if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
  } catch {}
</script>
<link rel="icon" type="image/png" sizes="64x64" href={`${base}/favicon.png`} />
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL(`${base}/rss.xml`, Astro.site)} />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />
<title>{title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`}</title>
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta name="twitter:card" content="summary" />


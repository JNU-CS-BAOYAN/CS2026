---
import { readFileSync } from 'node:fs';
import { sitePath } from '../lib/experiences';

interface Props { preview?: boolean; }
const { preview = false } = Astro.props;
const markdownTemplate = readFileSync('public/templates/submission-template.md', 'utf8');
---
<section class="submission-tools" aria-labelledby="submission-preparation">
  <h2 id="submission-preparation">{preview ? '模板下载与预览' : '① 准备稿件'}</h2>
  <div class="resource-card submission-template-card">
    <div class="submission-template-copy">
      <h3>下载投稿模板</h3>
      <p>参考模板写下个人背景、申请经历和经验总结，章节可自由调整。填写文章信息后，保存为 index.md。</p>
    </div>
    <div class="button-row">
      <a class="button" href={sitePath('/templates/submission-template.md')} download="index.md" data-template-download>下载 Markdown 模板</a>
      {!preview && <a class="button-secondary" href={sitePath('/submit/markdown/')}>Markdown 写作指南</a>}
    </div>
  </div>
  <p class="submission-status" role="status" aria-live="polite" data-template-status></p>
</section>
{preview ? (
  <details class="prose template-preview" data-template-preview>
    <summary>查看或复制 Markdown 模板</summary>
    <p>可复制后保存为 index.md。正文结构仅供参考；三个必填字段需要填写，可选字段不用时保留注释或删除即可。</p>
    <button class="button" type="button" data-copy-template hidden>复制模板</button>
    <pre><code data-template-source>{markdownTemplate}</code></pre>
  </details>
) : <div hidden data-template-source>{markdownTemplate}</div>}

<script>
  const downloadLink = document.querySelector<HTMLAnchorElement>('[data-template-download]');
  const source = document.querySelector<HTMLElement>('[data-template-source]');
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-template]');
  const status = document.querySelector<HTMLElement>('[data-template-status]');
  const preview = document.querySelector<HTMLDetailsElement>('[data-template-preview]');

  downloadLink?.addEventListener('click', (event) => {
    if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || !source) return;
    event.preventDefault();
    const url = URL.createObjectURL(new Blob([source.textContent ?? ''], { type: 'text/markdown;charset=utf-8' }));
    const link = document.createElement('a');
    link.href = url;
    link.download = downloadLink.download;
    document.body.append(link);
    link.click();
    link.remove();
    window.setTimeout(() => URL.revokeObjectURL(url), 10000);
    if (status) status.textContent = '已发起下载，请将 index.md 保存到你的投稿文件夹。';
  });

  if (copyButton) copyButton.hidden = false;
  copyButton?.addEventListener('click', async () => {
    if (!source || !status) return;
    try {
      await navigator.clipboard.writeText(source.textContent ?? '');
      status.textContent = '模板已复制，请粘贴到编辑器并保存为 .md 文件。';
    } catch {
      if (preview) preview.open = true;
      const range = document.createRange();
      range.selectNodeContents(source);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
      status.textContent = '模板已选中，请按 Ctrl+C 或 Command+C 复制。';
    }
  });
  const emailButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const emailLink = document.querySelector<HTMLAnchorElement>('[data-submission-email]');
  const emailStatus = document.querySelector<HTMLElement>('[data-email-status]');
  if (emailButton && emailLink) emailButton.hidden = false;
  emailButton?.addEventListener('click', async () => {
    if (!emailLink || !emailStatus) return;
    try {
      await navigator.clipboard.writeText(emailLink.getAttribute('href')!.replace(/^mailto:/, ''));
      emailStatus.textContent = '投稿邮箱已复制。';
    } catch {
      const range = document.createRange();
      range.selectNodeContents(emailLink);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
      emailStatus.textContent = '邮箱已选中，请按 Ctrl+C 或 Command+C 复制，也可以点击邮箱发送邮件。';
    }
  });
</script>

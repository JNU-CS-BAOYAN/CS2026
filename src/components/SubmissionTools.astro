---
import { readFileSync } from 'node:fs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const markdownTemplate = readFileSync('public/templates/submission-template.md', 'utf8');
---
<section class="resource-grid submission-tools">
    <div class="resource-card">
      <h3>Markdown 模板</h3>
      <p>下载为 index.md，按注释填写必填与选填字段，再撰写正文。</p>
      <p><a class="button" href={`${base}/templates/submission-template.md`} download="index.md" data-template-download>下载 .md 模板</a></p>
    </div>
    <div class="resource-card">
      <h3>PR 投稿</h3>
      <p>当前新稿放在 2026 年目录，将包含 index.md、封面和正文插图的文件夹提交为 PR。</p>
      <p><a class="button" href="https://github.com/JNU-CS-BAOYAN/CS2026">打开项目仓库</a></p>
    </div>
  </section>
  <details class="prose template-preview" data-template-preview>
    <summary>查看或复制 Markdown 模板</summary>
    <p>也可以复制下面的内容，保存为 index.md 后填写。可选字段无需填写时，保留注释或删除即可。</p>
    <button class="button" type="button" data-copy-template hidden>复制模板</button>
    <pre><code data-template-source>{markdownTemplate}</code></pre>
  </details>
  <p role="status" aria-live="polite" data-template-status></p>

<script>
  const downloadLink = document.querySelector<HTMLAnchorElement>('[data-template-download]');
  const source = document.querySelector<HTMLElement>('[data-template-source]');
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-template]');
  const status = document.querySelector<HTMLElement>('[data-template-status]');
  const preview = document.querySelector<HTMLDetailsElement>('[data-template-preview]');

  downloadLink?.addEventListener('click', (event) => {
    if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || !source) return;
    event.preventDefault();
    const url = URL.createObjectURL(new Blob([source.textContent ?? ''], { type: 'text/markdown;charset=utf-8' }));
    const link = document.createElement('a');
    link.href = url;
    link.download = downloadLink.download;
    document.body.append(link);
    link.click();
    link.remove();
    window.setTimeout(() => URL.revokeObjectURL(url), 10000);
    if (status) status.textContent = '已发起 .md 文件下载；也可以展开模板内容，复制后保存。';
  });

  if (copyButton) copyButton.hidden = false;
  copyButton?.addEventListener('click', async () => {
    if (!source || !status) return;
    try {
      await navigator.clipboard.writeText(source.textContent ?? '');
      status.textContent = '模板已复制，请粘贴到编辑器并保存为 .md 文件。';
    } catch {
      if (preview) preview.open = true;
      const range = document.createRange();
      range.selectNodeContents(source);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
      status.textContent = '模板已选中，请按 Ctrl+C 或 Command+C 复制。';
    }
  });
</script>
